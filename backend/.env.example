DJANGO_SECRET_KEY=change-me-to-a-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5174
CSRF_TRUSTED_ORIGINS=http://localhost:5174

DB_NAME=fleet_maintenance
DB_USER=fleet_maintenance
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432

# Google Sheets one-way mirror sync (a brand-new, separate sheet from the
# legacy fleet app's — never point this at the legacy sheet)
FLEET_SHEETS_KEYFILE=secrets/service-account.json
FLEET_SHEET_ID=
FLEET_SHEET_TAB=Fleet

# One-time import source only — the legacy fleet app's existing sheet.
# Must be shared with the service account (Viewer is enough) before running
# `manage.py import_from_sheet`. Unset once the import is done.
FLEET_LEGACY_SHEET_ID=

# Google Sign-In — dormant unless both are set; the shared login (accounts
# app) below is the real sign-in path.
GOOGLE_OAUTH_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_ALLOWED_EMAIL=shared-account@gmail.com
